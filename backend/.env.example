# Copy to .env and adjust. Everything has a sensible local default.
APP_ENV=development
# 32+ random characters. Required when APP_ENV=production. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# SQLite by default; any SQLAlchemy URL works (e.g. postgresql+psycopg://user:pass@host/vroomble)
DATABASE_URL=sqlite:///./data/vroomble.db
MEDIA_DIR=./data/media
MAX_UPLOAD_MB=8
CORS_ORIGINS=http://localhost:3000
# Set true when serving over HTTPS
COOKIE_SECURE=false

# First admin account (created on first start if none exists)
ADMIN_EMAIL=admin@vroomble.app
ADMIN_PASSWORD=change-me-please

# Optional: email price predictions to users (e.g. Gmail app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
